# ── DenjiXstream deployment configuration ────────────────────────────
# Copy this file to `.deploy.env` and fill in the values.
# ⚠️ `.deploy.env` is gitignored — NEVER commit real tokens.
# `node deploy.mjs` reads `.deploy.env` automatically (no prompts).

# GitHub fine-grained PAT (Contents: Read & write on the repo,
# + Administration: Read & write only if you want auto repo-creation)
# or classic PAT with `repo` scope.
GITHUB_TOKEN=github_pat_xxx

# Cloudflare API token — My Profile → API Tokens → "Edit Cloudflare Workers"
# template (Account → Workers Scripts → Edit).
CF_API_TOKEN=xxxx

# Cloudflare Account ID — Workers & Pages page → right sidebar (32 hex chars)
CF_ACCOUNT_ID=00000000000000000000000000000000

# Optional overrides (defaults shown)
SITE_NAME=DenjiXstream
REPO_NAME=denjixstream
CF_WORKER_NAME=denjixstream
